# Required in production: connect a Vercel Blob store to your project and
# Vercel injects this automatically. For local dev without Vercel, create
# a store at vercel.com -> Storage -> Blob and paste its token here.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Optional: powers automatic style classification on upload.
# Without it, uploads are simply tagged "Uncategorized".
ANTHROPIC_API_KEY=your-anthropic-api-key

# Branding (all optional, sensible defaults if omitted)
NEXT_PUBLIC_SITE_NAME=Gallery
NEXT_PUBLIC_ACCENT_COLOR=#c9a227
NEXT_PUBLIC_GRID_COLUMNS=4
